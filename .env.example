# Optional local settings. Do not put real credentials in this file or Git.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_DEMAND=taxi-demand-forecasting
MLFLOW_EXPERIMENT_FARE=taxi-fare-prediction
MLFLOW_ARTIFACT_ROOT=

TLC_TRIP_YEAR=2024
TLC_TRIP_MONTH=1
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_FEATURES_DIR=data/features

# The dashboard reads API_BASE_URL directly from its process environment.
# Set it in the shell before starting Streamlit; this file alone does not set it.

# Set cloud destinations in your own environment only when explicitly deploying.
AWS_REGION=us-east-1
DATALAKE_BUCKET=
DATALAKE_PREFIX=
MONITORING_BUCKET=
CAPTURE_PREFIX=captured/
SAGEMAKER_ROLE_ARN=
ALERT_EMAIL=
# Infrastructure schedules are configured through Terraform variables.